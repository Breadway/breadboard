{
  "name": "@breadboard/api-client",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript client for breadboard-server (REST + SSE)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
